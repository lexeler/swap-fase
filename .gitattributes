# Normalize line endings across platforms (this repo is cross-platform: Windows +
# Linux + macOS). Text files are stored with LF in the repo; checked out native.
* text=auto eol=lf

# Shell scripts and Python must stay LF even on Windows checkouts.
*.sh    text eol=lf
*.py    text eol=lf

# PowerShell installer must use CRLF on Windows.
*.ps1   text eol=crlf
*.bat   text eol=crlf
*.cmd   text eol=crlf

# Treat model/image binaries as binary (no EOL munging, no diff noise).
*.onnx  binary
*.pth   binary
*.png   binary
*.jpg   binary
*.jpeg  binary
*.webp  binary
*.bmp   binary
